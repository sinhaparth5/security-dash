# Read by `docker run --env-file`: values are taken literally, so no quotes and no ${VAR} references.
APP_NAME=Patchwatch
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show
APP_KEY=
APP_URL=https://security-dash.example.com

DB_HOST=goc-postgres
DB_PORT=5432
DB_DATABASE=security_dash
DB_USERNAME=security_dash
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database
LOG_CHANNEL=stderr

# GitHub OAuth app: callback URL is ${APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_LOGINS=sinhaparth5

# Cloudflare Email Service over SMTP (port 465, implicit TLS only).
# MAIL_PASSWORD is a Cloudflare API token with the "Email Sending: Edit" permission;
# MAIL_FROM_ADDRESS must use a domain onboarded for Email Sending on that account.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.mx.cloudflare.net
MAIL_PORT=465
MAIL_USERNAME=api_token
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=patchwatch@example.com
MAIL_FROM_NAME=Patchwatch
